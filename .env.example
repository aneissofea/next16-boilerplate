NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SITE_NAME="my project"

NEXT_DEV_PORT=3618
# Stable local dev-server port — set automatically by the setup wizard
# (hashed from the project name so the same project always gets the same
# port on every machine). List running dev servers: npm run dev:who

NEXT_PUBLIC_API_DOMAIN=https://cms.com
NEXT_PUBLIC_SITE_MODE=preview
# preview || preview-local || production

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=

NEXT_BASIC_AUTH_USER=
NEXT_BASIC_AUTH_PASS=
